# Configuração local de máquina (permissões, overrides de sessão) — nunca canônica.
# Declaração canônica do que o harness lê mora em `.claude/projecoes.json` (versionado);
# este arquivo é a materialização local, produzida por `python .claude/tools/materializar.py apply`.
.claude/settings.local.json
.claude/settings.json

# Slot de estado de sessão do loop autônomo. O diretório é canônico do framework e viaja
# versionado (`.gitkeep`), para que o Passo 4 do `scrum-master` nunca grave em caminho
# inexistente; o conteúdo (ex.: tarefa-corrente.json, escrito no despacho e consumido pelo hook
# `SubagentStop` — T55) é fato de uma sessão numa máquina e nunca se versiona.
.claude/estado/*
!.claude/estado/.gitkeep

# Bytecode do Python — a suíte do hub (`tests/`) carrega os verificadores de
# `.claude/checks/` por caminho, e cada rodada grava `__pycache__/` ao lado deles
__pycache__/
*.pyc

# Ruído de SO / editor
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
.idea/
.vscode/

# Transcrições e artefatos efêmeros de sessão de agente
*.log
scratchpad/

# Embriao da ramificacao desktop/PySide6 do framework — conhecimento extraido do hub
# universal, preservado fora do versionamento ate virar repositorio proprio.
PantonicForDesktop/

# Embriao da ramificacao container/Docker do framework — conhecimento extraido do hub
# universal, preservado fora do versionamento ate virar repositorio proprio.
PantonicForContainer/

# Residuo de crash do msys (AE-68) - nao e autoria
*.stackdump
